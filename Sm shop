<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>SM KINGDOM V1</title>
    <style>
        body { background: #050505; color: #fff; font-family: sans-serif; margin: 0; }
        .header { display: flex; justify-content: space-between; padding: 20px; background: #111; border-bottom: 2px solid #222; }
        .sidebar { position: fixed; right: -320px; top: 0; width: 300px; height: 100%; background: #111; transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1); z-index: 1000; padding-top: 80px; border-left: 2px solid #333; }
        .cart-item { display: flex; justify-content: space-between; align-items: center; background: #222; padding: 12px; margin: 10px; border-radius: 10px; }
        .qty-btn { background: #333; border: none; color: white; width: 30px; height: 30px; border-radius: 5px; cursor: pointer; }
        .card { background: #161616; padding: 20px; margin: 15px; border-radius: 15px; border: 1px solid #333; }
        .btn-add { background: #008000; color: #fff; border: none; padding: 12px; width: 100%; border-radius: 8px; cursor: pointer; }
    </style>
</head>
<body>

<div class="header">
    <div onclick="toggleSidebar('sidebar')" style="cursor:pointer; font-size:28px;">☰</div>
    <div style="font-size:22px;">SM KINGDOM</div>
    <div onclick="toggleSidebar('sidebar')" style="cursor:pointer;">🛍️ <span id="cart-count">0</span></div>
</div>

<div id="sidebar" class="sidebar">
    <a onclick="toggleSidebar('sidebar')" style="padding:20px; display:block; cursor:pointer;">✕ إغلاق</a>
    <h3 style="padding:10px 20px;">سلة المشتريات</h3>
    <div id="cart-items"></div>
    <button onclick="checkout()" style="margin:20px; width:260px; padding:15px; background:#008000; border:none; color:white;">إتمام الطلب</button>
</div>

<div class="card"><h3>حزمة التهريب</h3><button class="btn-add" onclick="addItem('تهريب', 5)">إضافة للسلة</button></div>
<div class="card"><h3>GOLD</h3><button class="btn-add" onclick="addItem('GOLD', 15)">إضافة للسلة</button></div>

<script>
    let cart = [];

    function toggleSidebar(id) {
        let s = document.getElementById(id);
        s.style.right = (s.style.right === "0px") ? "-320px" : "0px";
    }

    function addItem(name, price) {
        let found = cart.find(i => i.name === name);
        if(found) found.qty++;
        else cart.push({name, price, qty: 1});
        updateCart();
    }

    function changeQty(name, delta) {
        let item = cart.find(i => i.name === name);
        if(item) {
            item.qty += delta;
            if(item.qty <= 0) cart = cart.filter(i => i.name !== name);
        }
        updateCart();
    }

    function updateCart() {
        let list = document.getElementById('cart-items');
        let count = 0;
        list.innerHTML = cart.map(item => {
            count += item.qty;
            return `
            <div class="cart-item">
                ${item.name}
                <div>
                    <button class="qty-btn" onclick="changeQty('${item.name}', -1)">-</button>
                    <span>${item.qty}</span>
                    <button class="qty-btn" onclick="changeQty('${item.name}', 1)">+</button>
                </div>
            </div>`;
        }).join('');
        document.getElementById('cart-count').innerText = count;
    }

    function checkout() {
        let name = prompt("أدخل اسمك الكريم للدفع:");
        if(name) {
            fetch('https://discord.com/api/webhooks/1508279331019952178/flKj3D94Oxty_hbT7RX_vzenMX8jfygyXGlNZTclhC9YdlbSMHf_es2qLpGUBbK8d5FL', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({content: `طلب جديد من: ${name}\nالمحتوى: ${cart.map(i => i.name + ' (' + i.qty + ')').join(', ')}`})
            });
            alert("تم إرسال الطلب!");
        }
    }
</script>
</body>
</html>
function addItem(name, price) {
    let found = cart.find(i => i.name === name);
    if(found) found.qty++;
    else cart.push({name, price, qty: 1});
    updateCart();
    
    // أضف هذا السطر هنا عشان تفتح السلة تلقائياً عند الإضافة
    document.getElementById('sidebar').style.right = "0px"; 
}
